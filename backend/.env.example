# Puerto de la API
PORT=3000

# Conexión a SQL Server (ver database/GUIA_SQL_SERVER.md)
DATABASE_URL="sqlserver://localhost:1433;database=jorge_motors;user=jorge_app;password=CAMBIAR;encrypt=true;trustServerCertificate=true"

# Clave para firmar los tokens JWT (mínimo 16 caracteres, cámbiala)
JWT_SECRET=CAMBIAR
JWT_EXPIRA=8h

# Dirección del frontend (CORS)
CORS_ORIGEN=http://localhost:5173

# true: al detectar bajo stock, la alerta se envía sola al proveedor
ALERTAS_ENVIO_AUTOMATICO=true
